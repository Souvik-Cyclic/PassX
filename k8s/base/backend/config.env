# Non-secret backend settings for ConfigMap backend-config.
# Its hash suffix means any change rolls the Deployment.
NODE_ENV=production
PORT=3000
METRICS_PORT=9464
METRICS_HOST=0.0.0.0
LOG_LEVEL=info
MONGO_DB_NAME=passx
CORS_ORIGINS=
TRUST_PROXY=1
OTEL_SERVICE_NAME=passx-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-collector.monitoring.svc.cluster.local:4317
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
BREAK_READINESS=false
